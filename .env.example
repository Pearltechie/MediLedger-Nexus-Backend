# MediLedger Nexus environment template
# Copy this file to .env for local development and replace blank sensitive values.
# Never commit .env or paste production secrets into this file.

# Application
# Display name used by the API.
APP_NAME=MediLedger Nexus
# Application release version.
APP_VERSION=0.1.0
# Enable verbose development behavior; keep false in production.
DEBUG=false
# Runtime environment name, such as development, testing, or production.
ENVIRONMENT=development

# Server
# Host interface for the HTTP server.
HOST=0.0.0.0
# HTTP port; the platform PORT value takes precedence where applicable.
PORT=8000
# Reload application code automatically during local development.
RELOAD=false

# Database
# SQLAlchemy database connection URL.
DATABASE_URL=sqlite:///./mediledger_nexus.db
# Emit SQL statements to logs when enabled.
DATABASE_ECHO=false
# Optional database URL used by tests.
TEST_DATABASE_URL=

# Redis
# Redis connection URL for caching or background coordination.
REDIS_URL=redis://localhost:6379/0

# Security and Encryption
# Secret used to sign access tokens. Generate a long random value.
SECRET_KEY=
# Access-token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# JWT signing algorithm.
ALGORITHM=HS256
# Base64-encoded encryption key used by the application encryption service.
ENCRYPTION_KEY=

# Hedera Network
# Hedera network name, for example testnet or mainnet.
HEDERA_NETWORK=testnet
# Hedera account identifier in shard.realm.num format.
HEDERA_ACCOUNT_ID=
# Hedera operator private key. Load from a secret manager or local untracked .env.
HEDERA_PRIVATE_KEY=
# Optional public key corresponding to HEDERA_PRIVATE_KEY.
HEDERA_PUBLIC_KEY=
# Optional raw private key format used by legacy tooling.
HEDERA_PRIVATE_KEY_RAW=
# Optional raw public key format used by legacy tooling.
HEDERA_PUBLIC_KEY_RAW=
# Hedera operator account used by archived account-creation tooling.
HEDERA_OPERATOR_ID=
# Hedera operator private key used by archived account-creation tooling.
HEDERA_OPERATOR_KEY=

# Hedera Services
# HCS topic identifier for consent or audit messages.
HCS_TOPIC_ID=
# HTS token identifier used by health-token features.
HEAL_TOKEN_ID=

# Smart Contracts
# HealthVault contract address.
HEALTH_VAULT_CONTRACT=
# Consent contract address.
CONSENT_CONTRACT=
# Research study contract address.
RESEARCH_CONTRACT=
# Emergency access contract address.
EMERGENCY_CONTRACT=

# IPFS and Arweave
# IPFS node API URL.
IPFS_NODE_URL=http://localhost:5001
# Public or gateway URL used to retrieve IPFS content.
IPFS_GATEWAY_URL=http://localhost:8080
# Arweave node URL.
ARWEAVE_NODE_URL=https://arweave.net
# Path to the local Arweave wallet file; keep the wallet file untracked.
ARWEAVE_WALLET_PATH=./arweave-wallet.json

# Zero-Knowledge Proofs
# Path to the ZoKrates proving key.
ZK_SNARK_PROVING_KEY_PATH=./zk/proving_key.json
# Path to the ZoKrates verification key.
ZK_SNARK_VERIFICATION_KEY_PATH=./zk/verification_key.json

# AI and Machine Learning
# Directory containing local models.
MODEL_PATH=./models
# Number of federated-learning rounds.
FEDERATED_LEARNING_ROUNDS=10
# Minimum participants required for a federated-learning round.
MIN_PARTICIPANTS=3
# Optional Groq API key for AI features.
GROQ_API_KEY=
# Groq model name.
GROQ_MODEL=llama3-8b-8192
# Maximum tokens requested from the Groq API.
GROQ_MAX_TOKENS=4096
# Sampling temperature for Groq responses.
GROQ_TEMPERATURE=0.7

# Logging and Monitoring
# Python logging level, such as DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO
# Python logging format string.
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
# Optional Sentry DSN for error monitoring.
SENTRY_DSN=
# Port used by the Prometheus metrics endpoint.
PROMETHEUS_PORT=9090

# CORS
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Allow cookies and authorization credentials in CORS requests.
CORS_CREDENTIALS=true
# Comma-separated HTTP methods allowed by CORS.
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
# Allowed CORS request headers.
CORS_HEADERS=*

# File Uploads
# Maximum upload size in megabytes.
MAX_FILE_SIZE=100
# Comma-separated allowed upload extensions.
ALLOWED_FILE_EXTENSIONS=.pdf,.dcm,.fastq,.json,.xml
# Directory where uploaded files are stored.
UPLOAD_PATH=./uploads

# Health and Rate Limiting
# Interval in seconds between health checks.
HEALTH_CHECK_INTERVAL=30
# Maximum requests allowed per client per minute.
RATE_LIMIT_PER_MINUTE=100

# Demo and Tests
# Email used by backend/api_demo.py in local development.
DEMO_EMAIL=demo@mediledgernexus.com
# Password used by backend/api_demo.py; set locally and never commit it.
DEMO_PASSWORD=
# Enables test-only behavior when set to true.
TESTING=false
# Test-only encryption key used by encryption tests.
TEST_ENCRYPTION_KEY=
# Test-only invalid-key fixture value.
TEST_INVALID_KEY=
# Test-only project-name override used by configuration tests.
PROJECT_NAME=
# Test-only version override used by configuration tests.
VERSION=
# Test-only Hedera mirror-node URL override.
HEDERA_MIRROR_NODE_URL=
# Test-only legacy IPFS API URL override.
IPFS_API_URL=
# Test-only legacy Arweave gateway URL override.
ARWEAVE_GATEWAY_URL=
# Test-only RSA key-size override.
RSA_KEY_SIZE=
# Test-only AES key-size override.
AES_KEY_SIZE=
